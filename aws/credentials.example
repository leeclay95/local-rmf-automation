# Emulated credentials only — minted by Floci's IAM service, valid nowhere else.
# Copied to aws/credentials on first run; scripts/01-bootstrap-iam.sh then
# rewrites [floci-lab] with the real emulated key.
[floci-bootstrap]
aws_access_key_id = test
aws_secret_access_key = test

[floci-lab]
aws_access_key_id = test
aws_secret_access_key = test
